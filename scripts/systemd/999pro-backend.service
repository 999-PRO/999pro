# ============================================================================
# 999 PRO Backend — systemd unit template
# ----------------------------------------------------------------------------
# This file is processed by scripts/install-services.sh which replaces
# __ROOT__, __BACKEND__, __NODE__, __USER__ with actual values.
#
# After install, the unit lives at /etc/systemd/system/999pro-backend.service
# and is managed with:
#   sudo systemctl start 999pro-backend
#   sudo systemctl stop 999pro-backend
#   sudo systemctl restart 999pro-backend
#   sudo systemctl status 999pro-backend
#   sudo journalctl -u 999pro-backend -f
# ============================================================================

[Unit]
Description=999 PRO Backend (Express + Prisma + Socket.IO)
Documentation=https://github.com/999pro/999pro
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__BACKEND__

# Load .env file via EnvironmentFile (generated by npm run setup)
EnvironmentFile=__BACKEND__/.env
Environment=NODE_ENV=production

ExecStart=__NODE__ dist/index.js

# Auto-restart on crash. RestartSec=5 means 5s pause between restarts
# (prevents rapid crash loops from burning CPU).
Restart=on-failure
RestartSec=5

# Give the service 30s to start up before systemd considers it failed.
# Backend needs to: connect to PostgreSQL, run Prisma migrations, start
# Express + Socket.IO. On a cold VPS this can take 10-15s.
TimeoutStartSec=30

# Graceful shutdown: send SIGTERM, wait 15s, then SIGKILL.
# Backend's shutdown handler closes Socket.IO + Prisma gracefully.
KillSignal=SIGTERM
TimeoutStopSec=15

# Resource limits — tuned for a 2-4 GB VPS. Adjust per host.
MemoryMax=1G
MemoryHigh=768M
LimitNOFILE=65536

# Logging — send stdout/stderr to journald (viewable via journalctl).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=999pro-backend

# Security hardening (defense-in-depth — backend still needs network + FS
# access for uploads, so we can't lock down too aggressively).
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
