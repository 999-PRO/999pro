# ============================================================================
# 999 PRO Studio — systemd unit template
# ----------------------------------------------------------------------------
# Next.js standalone admin panel (basePath=/studio) on port 3001.
#
# v25.2-fix: REMOVED ProtectSystem=full + ProtectHome=read-only because
# Next.js standalone needs to write to .next/cache for image optimization
# and ISR. ReadWritePaths=__STUDIO__ explicitly allows writes only to the
# studio directory.
# ============================================================================

[Unit]
Description=999 PRO Studio (Next.js standalone admin panel)
Documentation=https://github.com/999pro/999pro
After=network.target 999pro-backend.service
Wants=999pro-backend.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__STUDIO__

EnvironmentFile=__STUDIO__/.env
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOSTNAME=0.0.0.0

# Ensure the Next.js cache directory exists before the server starts.
ExecStartPre=-/usr/bin/install -d -o __USER__ -g __GROUP__ -m 0755 __STUDIO__/.next/cache

ExecStart=__NODE__ .next/standalone/server.js

Restart=on-failure
RestartSec=5
TimeoutStartSec=30
KillSignal=SIGTERM
TimeoutStopSec=15

MemoryMax=512M
MemoryHigh=384M
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=999pro-studio

NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=__STUDIO__

[Install]
WantedBy=multi-user.target
