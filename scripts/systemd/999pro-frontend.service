# ============================================================================
# 999 PRO Frontend — systemd unit template
# ----------------------------------------------------------------------------
# Next.js standalone server (user-facing app) on port 3000.
#
# v25.2-fix: REMOVED ProtectSystem=full + ProtectHome=read-only because
# Next.js standalone needs to write to .next/cache for image optimization
# and ISR. ReadWritePaths=__ROOT__ explicitly allows writes only to the
# project directory.
# ============================================================================

[Unit]
Description=999 PRO Frontend (Next.js standalone)
Documentation=https://github.com/999pro/999pro
After=network.target 999pro-backend.service
Wants=999pro-backend.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__ROOT__

# Next.js standalone reads .env from cwd (project root).
EnvironmentFile=__ROOT__/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0

# Ensure the Next.js cache directory exists before the server starts.
ExecStartPre=-/usr/bin/install -d -o __USER__ -g __GROUP__ -m 0755 __ROOT__/.next/cache

ExecStart=__NODE__ .next/standalone/server.js

Restart=on-failure
RestartSec=5
TimeoutStartSec=30
KillSignal=SIGTERM
TimeoutStopSec=15

MemoryMax=1G
MemoryHigh=768M
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=999pro-frontend

NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=__ROOT__

[Install]
WantedBy=multi-user.target
