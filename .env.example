# 999 PRO Frontend — .env.example
# Copy to .env and edit as needed. NEVER commit the real .env file.
#
# This file is auto-generated by `npm run setup` (scripts/setup.js).
# The setup script generates cryptographically-strong secrets and writes
# them to .env, mini-services/backend/.env, and mini-services/studio/.env.
#
# After setup, edit the values below for your deployment.

# ---- Backend URL (server-side only) ----
# In production with Nginx: http://localhost:4000 (Next.js server proxies to backend)
BACKEND_URL=http://localhost:4000

# ---- Public API base ----
# Empty = use relative /api/* paths (recommended when behind Nginx reverse proxy)
# The browser always uses relative paths so there's no CORS preflight.
NEXT_PUBLIC_API_BASE=

# ---- Yandex Maps API key (optional) ----
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# ---- Iframe embedding (false in prod for clickjacking protection) ----
ALLOW_IFRAME=false

# ---- AI Assistant (optional, server-side only) ----
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Mobile deep linking (optional) ----
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=pro.ninehundred.app
ANDROID_PACKAGE_NAME=pro.ninehundred.app
ANDROID_SHA256_FINGERPRINT=
