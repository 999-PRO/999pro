# 999 PRO Frontend — environment template (.env.example)
# Copy to .env and fill in with real values. Never commit .env to git.
#
# In Docker production (docker-compose.prod.yml), these are set automatically
# via the `environment:` block. This file is for local dev / preview only.

# Backend URL (used by Next.js server-side rewrites in next.config.ts).
# In Docker prod: http://backend:4000
# In local dev:   http://localhost:4000
BACKEND_URL=http://localhost:4000

# Public API base. Empty = use relative /api/* paths (recommended for prod —
# lets Caddy reverse-proxy /api/* to the backend). Set to a full URL only if
# the backend is on a different domain.
NEXT_PUBLIC_API_BASE=

# Public API port — used by the sandbox preview gateway to route API requests.
# In production this is not needed (Caddy handles routing).
NEXT_PUBLIC_API_PORT=4000

# Yandex Maps API key (optional — required for the delivery address picker on
# non-localhost domains). Get a free key at:
#   https://developer.tech.yandex.ru/maps/
# Without a key: works on localhost only (dev).
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Iframe embedding — set to true in dev/preview, false (or omit) in production
# for clickjacking protection.
ALLOW_IFRAME=true

# ============================================================================
# AI ASSISTANT (DeepSeek) — v18.5
# ============================================================================
# Server-side only. NEVER prefixed with NEXT_PUBLIC_ — must NOT be exposed
# to the browser. The backend reads this key and proxies all DeepSeek calls.
#
# Get a key at https://platform.deepseek.com/
# 1. Sign up / log in to DeepSeek platform
# 2. Go to API Keys → Create new key
# 3. Copy the key (starts with "sk-")
# 4. Paste it below (no quotes needed)
#
# If left empty: the AI Assistant still works (local fallback responses),
# but answers won't have the natural DeepSeek phrasing.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================================================================
# DEV HINTS — admin login screen
# ============================================================================
# When set to "1", the admin login screen shows a hint reminding the operator
# to use `bunx tsx scripts/create-admin.ts` to set credentials. NEVER enable
# in production — it's a minor info-leak (mentions the script name).
# NEXT_PUBLIC_DEV_HINTS=1

# ============================================================================
# MOBILE DEEP LINKING (optional — iOS Universal Links + Android App Links)
# ============================================================================
# v24.7 (final-release audit): these are REQUIRED for production if you want
# native app deep-linking to work. Without them, the /apple-app-site-association
# and /assetlinks.json routes will return HTTP 500 in production (fail-fast).
#
# Get these from your Apple Developer account and Android Play Console:
#   APPLE_TEAM_ID — 10-char Apple Developer Team ID (e.g. "ABCDE12345")
#   APPLE_BUNDLE_ID — iOS app bundle ID (default: "pro.ninehundred.app")
#   ANDROID_PACKAGE_NAME — Android package name (default: "pro.ninehundred.app")
#   ANDROID_SHA256_FINGERPRINT — SHA-256 of your Android signing key
#     (generate with: keytool -list -v -keystore your.keystore -alias your_alias)
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=pro.ninehundred.app
ANDROID_PACKAGE_NAME=pro.ninehundred.app
ANDROID_SHA256_FINGERPRINT=

# ============================================================================
# SENTRY (optional — error tracking)
# ============================================================================
# PII (IPs, User-Agents, URL query strings) is automatically scrubbed by the
# backend's lib/logger.ts and the frontend's sentry-init.tsx. Set SENTRY_DSN
# to enable; leave empty to disable.
# SENTRY_DSN=
# SENTRY_SEND_PII=false

