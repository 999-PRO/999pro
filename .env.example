# 999 PRO Frontend — .env.example
# Copy to .env and edit as needed. NEVER commit the real .env file.
#
# This file is auto-generated by `npm run setup` (scripts/setup.js).
# The setup script generates cryptographically-strong secrets and writes
# them to .env, mini-services/backend/.env, and mini-services/studio/.env.
#
# After setup, edit the values below for your deployment.

# ---- Backend URL (server-side only) ----
# In production with Nginx: http://localhost:4000 (Next.js server proxies to backend)
BACKEND_URL=http://localhost:4000

# ---- Studio URL (server-side only) ----
# v25.10: used by next.config.ts rewrites to proxy /studio/* requests.
# Default: http://localhost:3001 (single-host prod).
# On Smart TV / multi-host deployments, set this to the studio's PUBLIC URL
# (e.g. https://studio.tri-999.online) — otherwise the TV can't reach the
# studio via localhost.
STUDIO_URL=http://localhost:3001

# ---- Public API base ----
# Empty = use relative /api/* paths (recommended when behind Nginx reverse proxy)
# The browser always uses relative paths so there's no CORS preflight.
NEXT_PUBLIC_API_BASE=

# ---- Yandex Maps API key (optional) ----
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# ---- Iframe embedding (false in prod for clickjacking protection) ----
ALLOW_IFRAME=false

# ---- AI Assistant (optional, server-side only) ----
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Mobile deep linking (optional) ----
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=pro.ninehundred.app
ANDROID_PACKAGE_NAME=pro.ninehundred.app
ANDROID_SHA256_FINGERPRINT=

# ---- Public app URL (REQUIRED for production SEO) ----
# Used by: metadataBase, OG image URLs, canonical URLs, sitemap, JSON-LD.
# If unset, falls back to http://localhost:3000 → broken share previews.
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
APP_PUBLIC_URL=https://your-production-domain.com

# ---- Search engine verification (optional) ----
# Google Search Console: https://search.google.com/search-console
# Add a property → verify via meta tag → paste the content value here.
GOOGLE_SITE_VERIFICATION=
# Yandex Webmaster: https://webmaster.yandex.ru
YANDEX_VERIFICATION=

# ---- Local business info (optional, for LocalBusiness JSON-LD) ----
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS_STREET=
NEXT_PUBLIC_BUSINESS_ADDRESS_CITY=
NEXT_PUBLIC_BUSINESS_ADDRESS_REGION=
NEXT_PUBLIC_BUSINESS_ADDRESS_ZIP=
NEXT_PUBLIC_BUSINESS_ADDRESS_COUNTRY=RU
NEXT_PUBLIC_BUSINESS_GEO_LAT=
NEXT_PUBLIC_BUSINESS_GEO_LNG=
