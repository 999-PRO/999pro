# ============================================================================
# 999 PRO — root .env.example (frontend)
# ============================================================================
# Copy to .env for local dev. For PRODUCTION use ./generate-env.sh which
# produces a complete .env.prod with cryptographically-strong secrets.
# ============================================================================

# ---- Backend URL (used by Next.js server-side rewrites in next.config.ts) ----
# In Docker prod: http://backend:4000 (set by compose)
# In local dev:   http://localhost:4000
BACKEND_URL=http://localhost:4000

# ---- Public API base ----
# Empty = use relative /api/* paths (recommended — lets Caddy reverse-proxy
# /api/* to the backend). Set to a full URL only if the backend is on a
# different domain.
NEXT_PUBLIC_API_BASE=

# ---- Yandex Maps API key (optional — required for delivery map on non-localhost) ----
# Get a free key at: https://developer.tech.yandex.ru/maps/
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# ---- Iframe embedding (set to false in prod for clickjacking protection) ----
ALLOW_IFRAME=true

# ============================================================================
# AI ASSISTANT (DeepSeek) — optional
# ============================================================================
# Server-side only. NEVER prefixed with NEXT_PUBLIC_. The backend proxies
# all DeepSeek calls (this is the FALLBACK — preferred config is via Studio).
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================================================================
# Mobile deep linking (optional — iOS Universal Links + Android App Links)
# ============================================================================
# Required only if you ship native apps that should open share links directly.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=pro.ninehundred.app
ANDROID_PACKAGE_NAME=pro.ninehundred.app
ANDROID_SHA256_FINGERPRINT=

# ============================================================================
# Sentry (optional — error tracking)
# ============================================================================
# PII (IPs, User-Agents, URL query strings) is automatically scrubbed.
# SENTRY_DSN=
# SENTRY_SEND_PII=false

# ============================================================================
# PRODUCTION DEPLOYMENT
# ============================================================================
# For production, do NOT use this file. Instead run:
#   ./generate-env.sh
# which produces a complete .env.prod with all required secrets (JWT_SECRET,
# FIRST_RUN_TOKEN, RESET_ADMIN_TOKEN, IP_HASH_PEPPER, VAPID_*, POSTGRES_PASSWORD)
# plus the secrets/postgres_password.txt Docker secret.
# See docker-compose.prod.yml for the full list of required env vars.
