# .dockerignore for 999 PRO (build context = project root for BOTH frontend
# and studio Dockerfiles — see docker-compose.prod.yml).
#
# Excludes only truly common dev artifacts. Service-specific source trees
# (mini-services/backend, mini-services/studio) are NOT excluded because the
# studio Dockerfile needs to COPY mini-services/studio/* from this context.

# Dependencies
node_modules
**/node_modules

# Build outputs
.next
**/.next
dist
**/dist

# VCS / metadata
.git
.gitignore
.github
.vscode
.idea
.DS_Store

# Logs
logs
*.log

# Env files (kept out of image — secrets come from runtime env)
.env
.env.*
!.env.example
.env.prod

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# Misc
*.tsbuildinfo
coverage
*.md
RELEASE-NOTES-*
secrets

# Backend build artifacts (we don't want them polluting frontend/studio images)
mini-services/backend/node_modules
mini-services/backend/dist
mini-services/backend/dev.db
mini-services/backend/dev.db-journal
mini-services/backend/uploads
