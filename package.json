{
  "name": "999pro-marketplace",
  "version": "25.0.0",
  "private": true,
  "description": "999 PRO Marketplace — frontend (Next.js), backend (Express + Prisma), studio (admin panel)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/build.js",
    "start": "node scripts/start.js",
    "setup": "node scripts/setup.js",
    "lint": "next lint",
    "analyze": "ANALYZE=true next build",
    "build:frontend": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "build:backend": "cd mini-services/backend && npm run build",
    "build:studio": "cd mini-services/studio && npm run build",
    "start:frontend": "node .next/standalone/server.js",
    "start:backend": "node mini-services/backend/dist/index.js",
    "start:studio": "node mini-services/studio/.next/standalone/server.js",
    "install:all": "node scripts/install-all.js",
    "db:push": "cd mini-services/backend && npx prisma db push",
    "db:generate": "cd mini-services/backend && npx prisma generate",
    "db:migrate": "cd mini-services/backend && npx prisma migrate dev",
    "db:reset": "cd mini-services/backend && npx prisma migrate reset",
    "db:seed": "cd mini-services/backend && npx tsx prisma/seed.ts",
    "db:deploy": "cd mini-services/backend && npx prisma migrate deploy && npx prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@999pro/shared": "file:packages/shared",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@sentry/nextjs": "^10.64.0",
    "@types/dompurify": "^3.2.0",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dashjs": "^5.2.0",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.23.2",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
