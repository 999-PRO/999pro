# ============================================================================
# 999 PRO — .gitignore (production-safe)
# ----------------------------------------------------------------------------
# Stage 18 (Security Audit) fix for S-CRIT-1: real .env, dev.db and uploads
# were tracked in git. This file ensures they never get re-tracked.
# ============================================================================

# --- Secrets / environment ---
.env
.env.local
.env.*.local
.env.production
.env.production.local
.env.development
.env.development.local
.env.test
.env.test.local
# Keep .env.example tracked (negate above)
!.env.example

# --- Database (v25.1: PostgreSQL is default; SQLite still supported) ---
*.db
*.db-journal
*.db-shm
*.db-wal
mini-services/backend/prisma/dev.db
mini-services/backend/prisma/dev.db-shm
mini-services/backend/prisma/dev.db-wal
mini-services/backend/prisma/*.db-journal
# v25.1: generated Prisma client (regenerated on install)
mini-services/backend/node_modules/.prisma/

# --- User uploads (production data — must never be in git) ---
mini-services/backend/uploads/
mini-services/backend/uploads/*
!mini-services/backend/uploads/.gitkeep

# --- Logs ---
logs/
*.log
dev.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Next.js build artifacts ---
.next/
out/
next-env.d.ts

# --- Build / cache directories ---
build/
dist/
.cache/
.turbo/
coverage/
*.tsbuildinfo

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Bun (no longer used — npm only) ---
bun.lockb
bun.lock
.bun/

# --- Docker (removed in v25 — npm-only deployment) ---
docker-compose*.yml
Dockerfile
.dockerignore

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Environment-specific configs (kept locally, not in git) ---

# --- Backups ---
*.bak
*.old
*.orig
backup-*.tar.gz
*-backup-*.tar.gz

# --- Testing / e2e artifacts ---
test-results/
playwright-report/
playwright/.cache/

# --- Sentry / monitoring configs with potential DSN ---
sentry.properties
.sentryclirc

# --- Prisma generated client (regenerated on install) ---
mini-services/backend/node_modules/.prisma/

# --- Misc temporary files ---
*.tmp
*.temp
TODO.md
NOTES.md
