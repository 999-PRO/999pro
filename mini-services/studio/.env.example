# 999 PRO Studio — environment template (.env.example)
# Copy to .env and fill in with real values. Never commit .env to git.

# API base URL — the studio's fetch wrapper prepends this to all /api/* paths.
# Empty = use relative /api/* paths (recommended — lets Caddy reverse-proxy
# /api/* to the backend). Set to a full URL only if the backend is on a
# different domain.
NEXT_PUBLIC_API_BASE=

# Public app URL — used for share links, OG images, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend origin — used by the studio's server-side proxy.ts to forward
# /api/* requests during SSR. Must match BACKEND_URL in the frontend .env.
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:4000

# Yandex Maps API key — required for the delivery address picker on non-localhost
# domains. Get a free key at https://developer.tech.yandex.ru/maps/
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Iframe embedding — set to true in dev/preview, false (or omit) in production
# for clickjacking protection.
ALLOW_IFRAME=true

# Dev hints — when set to "1", shows the default admin credentials on the
# Studio login screen. NEVER enable in production.
# NEXT_PUBLIC_DEV_HINTS=1

# Reset admin token — required for the "Forgot password" reset flow.
# Must match RESET_ADMIN_TOKEN in the backend .env.
# RESET_ADMIN_TOKEN=
