# 999 PRO Studio — .env.example
# Copy to .env and edit as needed. NEVER commit the real .env file.

# ---- API base URL ----
# Empty = use relative /studio/api/* paths (recommended — Next.js rewrites to backend)
NEXT_PUBLIC_API_BASE=

# ---- Public app URL ----
NEXT_PUBLIC_APP_URL=https://tri-999.online

# ---- Backend origin (server-side proxy) ----
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:4000

# ---- Yandex Maps API key (optional) ----
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# ---- Iframe embedding (true so the main app can embed /studio) ----
ALLOW_IFRAME=true
