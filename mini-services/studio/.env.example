# ============================================================================
# 999 PRO Studio — environment template (.env.example)
# ============================================================================
# For LOCAL DEV: copy to .env and adjust values.
# For PRODUCTION: env vars are set by docker-compose.prod.yml from .env.prod
# (which is auto-generated by ./generate-env.sh from the project root).

# ---- API base URL ----
# Empty = use relative /api/* paths (recommended — lets Caddy reverse-proxy
# /api/* to the backend). Set to a full URL only if backend is on a different
# domain.
NEXT_PUBLIC_API_BASE=

# ---- Public app URL (used for share links, OG images, etc.) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Backend origin (used by the studio's server-side proxy.ts) ----
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:4000

# ---- Yandex Maps API key (optional — required for delivery map on non-localhost) ----
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# ---- Iframe embedding (set to false in prod for clickjacking protection) ----
# In production, the main app embeds /studio via same-origin iframe — keep true
# so the same-origin embedding works, but cross-origin clickjacking is blocked
# by the studio's CSP frame-ancestors 'self' directive.
ALLOW_IFRAME=true

# ---- Dev hints (set to "1" in dev only — shows default admin creds on login screen) ----
# NEXT_PUBLIC_DEV_HINTS=1

# ---- Reset admin token (must match RESET_ADMIN_TOKEN in the backend .env) ----
# RESET_ADMIN_TOKEN=
