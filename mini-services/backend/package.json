{
  "name": "999-pro-backend",
  "version": "25.0.0",
  "description": "999 PRO — Backend API server with REST, Socket.IO chat, JWT auth, Prisma ORM",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "prisma generate && prisma migrate dev && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:cleanup": "tsx scripts/cleanup.ts",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/sanitize-html": "^2.16.1",
    "argon2": "^0.44.0",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.5.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "sanitize-html": "^2.17.6",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.19.3",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
