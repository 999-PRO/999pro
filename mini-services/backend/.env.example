# 999 PRO Backend — environment template (.env.example)
# Copy to .env and fill in with real values. Never commit .env to git.
#
# ============================================================================
# ⚠️  PRODUCTION DEPLOYMENT CHECKLIST (v16.8)
# ============================================================================
# Before running `docker compose -f docker-compose.prod.yml up`, you MUST:
#
# 1. Generate fresh secrets (do NOT reuse dev values):
#      JWT_SECRET=$(openssl rand -hex 48)
#      FIRST_RUN_TOKEN=$(openssl rand -hex 32)
#      RESET_ADMIN_TOKEN=$(openssl rand -hex 32)
#      IP_HASH_PEPPER=$(openssl rand -hex 32)
#      POSTGRES_PASSWORD=$(openssl rand -hex 24)
#
# 2. Regenerate VAPID keys for prod (dev keys are in committed .env — NEVER reuse):
#      bunx web-push generate-vapid-keys --json
#
# 3. Set a STRONG admin password (NOT admin12345):
#      ADMIN_PASSWORD="your-strong-password-here" bunx tsx scripts/create-admin.ts
#
# 4. Configure SMTP (required for email verification + password reset):
#      SMTP_HOST=smtp.yandex.ru
#      SMTP_PORT=587
#      SMTP_USER=no-reply@999.pro
#      SMTP_PASS=your-smtp-password
#      SMTP_FROM=no-reply@999.pro
#      SMTP_SECURE=false  # true for port 465, false for 587
#
# 5. Enable email verification in prod:
#      EMAIL_VERIFICATION_REQUIRED=true
#
# 6. The dev .env file MUST NOT be mounted into the prod container.
#    docker-compose.prod.yml uses explicit env: vars with fail-fast
#    ${VAR:?error} syntax — missing required vars will abort the deploy.
# ============================================================================

NODE_ENV=development
PORT=4000

# Database — SQLite for dev, PostgreSQL 16 for prod
# Dev (default):  BACKEND_DATABASE_URL="file:./dev.db"
# Prod:           BACKEND_DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/pro999?schema=public"
# Docker prod:    BACKEND_DATABASE_URL="postgresql://postgres:PASSWORD@postgres:5432/pro999?schema=public"
#
# Wave 4 (B-PROD-001): for production, use PostgreSQL. See MIGRATION-GUIDE.md
# for step-by-step migration from SQLite to PostgreSQL.
BACKEND_DATABASE_URL="file:./dev.db"

# CORS — explicit list of allowed origins in prod
# Dev:  CLIENT_ORIGIN="*"
# Prod: CLIENT_ORIGIN="https://999.pro,https://studio.999.pro"
CLIENT_ORIGIN="*"

# Trust proxy — set to true in prod behind Cloudflare/Caddy/Nginx
TRUST_PROXY=false

# JWT — generate with: openssl rand -hex 48
JWT_SECRET=replace_me_with_random_96_char_hex
JWT_EXPIRES_IN=7d

# Bcrypt rounds (OWASP 2024 baseline: 12)
BCRYPT_ROUNDS=12

# First-run admin setup wizard — generate with: openssl rand -hex 32
FIRST_RUN_TOKEN=replace_me_with_random_64_char_hex
RESET_ADMIN_TOKEN=replace_me_with_random_96_char_hex

# GDPR-compliant IP hashing — generate with: openssl rand -hex 32
IP_HASH_PEPPER=replace_me_with_random_64_char_hex

# Web Push (VAPID) — generate with: bunx web-push generate-vapid-keys --json
# WARNING: rotating VAPID keys invalidates ALL existing push subscriptions.
VAPID_SUBJECT=mailto:admin@999.pro
VAPID_PUBLIC_KEY=replace_me_with_base64_public_key
VAPID_PRIVATE_KEY=replace_me_with_base64_private_key

# Email verification — set to TRUE in production (requires SMTP configured)
EMAIL_VERIFICATION_REQUIRED=false

# SMTP — required when EMAIL_VERIFICATION_REQUIRED=true.
# Supports Yandex, Gmail, Mailgun, SendGrid, AWS SES, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@999.pro
SMTP_SECURE=false  # true for port 465 (implicit TLS), false for 587 (STARTTLS)

# Dev convenience: bypass admin TOTP for local testing.
# ⚠️ ONLY respected when NODE_ENV !== 'production'. In prod, admins MUST
# enroll TOTP (2FA) — there is no bypass.
BYPASS_ADMIN_TOTP=false

# Seed credentials (used only by prisma/seed.ts and scripts/create-admin.ts)
SEED_USER_PASSWORD=demo12345
ADMIN_EMAIL=admin@999.pro
ADMIN_USERNAME=admin
# ADMIN_PASSWORD is intentionally NOT in .env.
# Set it inline when running scripts/create-admin.ts:
#   ADMIN_PASSWORD="..." bunx tsx scripts/create-admin.ts

# Public URL (used for share links, email verification URLs, etc.)
APP_PUBLIC_URL=http://localhost:3000

# ============================================================================
# Yandex Maps API key (optional, recommended for production)
# ============================================================================
# Map picker (delivery address selection) uses Yandex Maps JS API 2.1.
# Without API key: works on localhost only (dev).
# With API key: works on any domain (free tier: 25,000 loads/day).
#
# Get a free key at: https://developer.tech.yandex.ru/maps/
# 1. Login with Yandex ID
# 2. Create "JavaScript API и HTTP Геокодер" service
# 3. Copy API key below
#
# This is a NEXT_PUBLIC_ variable — exposed to the browser intentionally.
# Yandex API keys are domain-restricted, not secret.
#
# NOTE: Set this in the FRONTEND .env (project root), NOT in backend .env.
# The frontend reads it via process.env.NEXT_PUBLIC_YANDEX_MAPS_API_KEY.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Optional: Sentry DSN for error tracking.
# PII (IPs, User-Agents, URL query strings) is automatically scrubbed
# in lib/logger.ts and src/instrumentation.ts. Set SENTRY_SEND_PII=true
# to override (NOT recommended without legal review).
# SENTRY_DSN=
# SENTRY_SEND_PII=false

# ============================================================================
# AI ASSISTANT (DeepSeek) — v18.5 / v19.0
# ============================================================================
# Server-side only. NEVER exposed to the browser. The backend reads this key
# and proxies all DeepSeek API calls. If left empty AND no provider is configured
# in Studio -> AI API, the AI Assistant still works with local fallback responses.
#
# Get a key at https://platform.deepseek.com/
# v19.0: These env vars are a FALLBACK -- preferred config is via Studio -> AI API
# where you can add multiple providers (DeepSeek, OpenAI, Gemini, Claude, Grok,
# OpenRouter, Ollama, custom) and switch between them at runtime.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================================================================
# JWT / SESSION -- v19.1
# ============================================================================
# Access token TTL -- uses SecuritySettings.sessionTimeoutMin (DB) by default.
# Override here only if you need a different value than the DB-configured one.
# JWT_EXPIRES_IN=7d
# Refresh token TTL -- uses SecuritySettings.refreshTokenTTLDays (DB) by default.
# Format: "<N>d" for days, "<N>h" for hours. Default: 7d.
# JWT_REFRESH_EXPIRES_IN=7d
# TOTP setup token TTL (seconds) -- short-lived token issued during 2FA enrollment.
# Default: 900 (15 min). Clamp range: 60-3600.
# TOTP_SETUP_TOKEN_TTL_SEC=900

# ============================================================================
# MODERATION LLM (optional) -- used by lib/moderation.ts for AI-powered
# content moderation. If unset, moderation uses rule-based filters only.
# ============================================================================
# MODERATION_LLM_API_KEY=
# MODERATION_LLM_BASE_URL=https://api.deepseek.com
# MODERATION_LLM_MODEL=deepseek-chat

# ============================================================================
# TURN SERVER (WebRTC relay) -- v16
# Used by /api/calls/ice-servers to issue short-lived TURN credentials.
# Without TURN, WebRTC calls fail when one peer is behind symmetric NAT.
# Free tier: https://www.metered.ca/stun-turn
# Self-host: see deploy/coturn.conf
# TURN_URL=turn:your-turn-server.example.com:3478
# TURN_USERNAME=999pro
# TURN_CREDENTIAL=your-shared-secret

# ============================================================================
# DATABASE (fallback) -- v19.0
# ============================================================================
# Used by lib/audit.ts for the Postgres advisory lock. Same as BACKEND_DATABASE_URL
# in most deployments. Only set explicitly if your audit log lives in a separate DB.
# DATABASE_URL=
