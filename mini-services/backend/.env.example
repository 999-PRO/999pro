# ============================================================================
# 999 PRO Backend — environment template (.env.example)
# ============================================================================
# For LOCAL DEV: copy to .env and adjust values.
# For PRODUCTION: run ./generate-env.sh from the project root — it produces a
# complete .env.prod with cryptographically-strong secrets AND the Docker
# secret file (./secrets/postgres_password.txt). Do NOT manually craft .env
# for production — you risk forgetting a required var and breaking the boot-
# time fail-fast check in lib/auth.ts.
# ============================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Database ----
# Dev (default):  SQLite
# Prod:           PostgreSQL 16 (set by docker-compose.prod.yml from a secret)
BACKEND_DATABASE_URL="file:./dev.db"

# ---- CORS — explicit list of allowed origins in prod ----
# Dev:  "*"
# Prod: "https://999.pro,https://studio.999.pro"
CLIENT_ORIGIN="*"

# ---- Trust proxy (set to true in prod behind Cloudflare/Caddy/Nginx) ----
TRUST_PROXY=false

# ============================================================================
# AUTH SECRETS — REQUIRED IN PRODUCTION (fail-fast at boot if missing)
# ============================================================================
# All of these are auto-generated by ./generate-env.sh. Generate fresh values
# for each environment; never reuse across dev/staging/prod.

# JWT signing secret — min 32 chars, 96 hex chars recommended.
# Generate: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First-run admin setup wizard token — min 16 chars.
# Generate: openssl rand -hex 32
FIRST_RUN_TOKEN=

# Admin reset token — min 16 chars.
# Generate: openssl rand -hex 32
RESET_ADMIN_TOKEN=

# GDPR-compliant IP hashing pepper — min 16 chars.
# Generate: openssl rand -hex 32
IP_HASH_PEPPER=

# Bcrypt rounds (OWASP 2024 baseline: 12)
BCRYPT_ROUNDS=12

# ============================================================================
# Web Push (VAPID) — REQUIRED IN PRODUCTION for push notifications
# ============================================================================
# Generate: ./generate-env.sh (auto-generates a P-256 ECDSA keypair)
# Or manually: bunx web-push generate-vapid-keys --json
# WARNING: rotating VAPID keys invalidates ALL existing push subscriptions.
VAPID_SUBJECT=mailto:admin@999.pro
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ============================================================================
# Email verification
# ============================================================================
EMAIL_VERIFICATION_REQUIRED=false

# SMTP — required when EMAIL_VERIFICATION_REQUIRED=true.
# Supports Yandex, Gmail, Mailgun, SendGrid, AWS SES, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@999.pro
SMTP_SECURE=false  # true for port 465 (implicit TLS), false for 587 (STARTTLS)

# ============================================================================
# Admin / seed (dev-only)
# ============================================================================
# Bypass admin TOTP for local testing. ⚠️ Only respected when NODE_ENV !== 'production'.
BYPASS_ADMIN_TOTP=false

# Seed credentials (used by prisma/seed.ts and scripts/create-admin.ts)
SEED_USER_PASSWORD=demo12345
ADMIN_EMAIL=admin@999.pro
ADMIN_USERNAME=admin
# ADMIN_PASSWORD is intentionally NOT in .env.
# Set it inline when running scripts/create-admin.ts:
#   ADMIN_PASSWORD="..." bunx tsx scripts/create-admin.ts

# ---- Public URL (used for share links, email verification URLs, etc.) ----
APP_PUBLIC_URL=http://localhost:3000

# ============================================================================
# Optional integrations
# ============================================================================

# Yandex Maps API key (set in the FRONTEND .env, not here)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Sentry DSN for error tracking (PII auto-scrubbed)
# SENTRY_DSN=
# SENTRY_SEND_PII=false

# AI ASSISTANT (DeepSeek) — fallback config; preferred is via Studio → AI API
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# JWT / SESSION (v19.1) — defaults are sensible, override only if needed
# JWT_REFRESH_EXPIRES_IN=7d
# TOTP_SETUP_TOKEN_TTL_SEC=900

# Moderation LLM (optional — used by lib/moderation.ts for AI content moderation)
# MODERATION_LLM_API_KEY=
# MODERATION_LLM_BASE_URL=https://api.deepseek.com
# MODERATION_LLM_MODEL=deepseek-chat

# TURN server (WebRTC relay) — needed for calls behind symmetric NAT
# TURN_URL=turn:your-turn-server.example.com:3478
# TURN_USERNAME=999pro
# TURN_CREDENTIAL=your-shared-secret

# Database fallback (only set explicitly if audit log lives in a separate DB)
# DATABASE_URL=
