# ============================================================================
# 999 PRO Backend — environment template (.env.example)
# ============================================================================
# For LOCAL DEV: copy to .env and adjust values.
# For PRODUCTION: run `npm run setup` from the project root — it generates a
# complete .env with cryptographically-strong secrets AND the VAPID keypair.
# Do NOT manually craft .env for production — you risk forgetting a required
# var and breaking the boot-time fail-fast check in lib/auth.ts.
# ============================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Database ----
# v25.1: PostgreSQL is the DEFAULT provider (production-grade).
# Format:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&connection_limit=10&pool_timeout=10
#
# Connection pool params (Prisma's internal pool):
#   connection_limit=10   — max simultaneous connections (good for 2-4 GB VPS)
#   pool_timeout=10       — seconds to wait for a free connection before erroring
#
# To create the database + user on a fresh PostgreSQL install:
#   sudo -u postgres psql
#   CREATE USER ninepro WITH PASSWORD 'your-strong-password';
#   CREATE DATABASE ninepro OWNER ninepro;
#   \q
#
# For SQLite (local dev only — NOT for production):
#   1. Set BACKEND_DATABASE_URL="file:./dev.db"
#   2. Run `node scripts/use-sqlite.js` (or `npm run setup -- --sqlite`)
#      to swap the Prisma schema provider.
BACKEND_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/999pro?schema=public&connection_limit=10&pool_timeout=10"

# ---- CORS — explicit list of allowed origins in prod ----
# Dev:  "http://localhost:3000,http://localhost:3001"
# Prod: "https://YOUR_DOMAIN,https://studio.YOUR_DOMAIN"
CLIENT_ORIGIN="http://localhost:3000,http://localhost:3001"

# ---- Trust proxy (set to "true" if behind Nginx/Caddy/Cloudflare) ----
TRUST_PROXY=false

# ============================================================================
# AUTH SECRETS — REQUIRED IN PRODUCTION (fail-fast at boot if missing)
# ============================================================================
# All of these are auto-generated by `npm run setup`. Generate fresh values
# for each environment; never reuse across dev/staging/prod.

# JWT signing secret — min 32 chars, 96 hex chars recommended.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# DEPRECATED in v25: FIRST_RUN_TOKEN is no longer read by the backend.
# The /api/auth/setup-admin endpoint is now token-less — it works purely
# on the precondition that no admin exists yet. The first admin is
# created through the web-based setup wizard at /studio (no curl, no
# terminal, no tokens). The var is still generated by `npm run setup`
# for backward compatibility with any external automation that might
# reference it; you can leave it empty.
FIRST_RUN_TOKEN=

# Admin reset token — min 16 chars. Still required for /reset-admin
# (the "forgot password" flow for admins, accessible from Studio).
RESET_ADMIN_TOKEN=

# GDPR-compliant IP hashing pepper — min 16 chars.
IP_HASH_PEPPER=

# Bcrypt rounds (OWASP 2024 baseline: 12)
BCRYPT_ROUNDS=12

# ============================================================================
# Web Push (VAPID) — REQUIRED IN PRODUCTION for push notifications
# ============================================================================
# Auto-generated by `npm run setup` (P-256 ECDSA keypair via Node.js crypto).
# Or manually: npx web-push generate-vapid-keys --json
# WARNING: rotating VAPID keys invalidates ALL existing push subscriptions.
VAPID_SUBJECT=mailto:admin@localhost
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ============================================================================
# Email verification
# ============================================================================
EMAIL_VERIFICATION_REQUIRED=false

# SMTP — required when EMAIL_VERIFICATION_REQUIRED=true.
# Supports Yandex, Gmail, Mailgun, SendGrid, AWS SES, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@localhost
SMTP_SECURE=false  # true for port 465 (implicit TLS), false for 587 (STARTTLS)

# ============================================================================
# Admin / seed (dev-only)
# ============================================================================
BYPASS_ADMIN_TOTP=false

# Seed credentials (used by prisma/seed.ts for demo data)
SEED_USER_PASSWORD=demo12345
ADMIN_EMAIL=admin@localhost
ADMIN_USERNAME=admin

# NOTE (v25): The first admin is now created through the web-based setup
# wizard at /studio — NOT through scripts/create-admin.ts. That script
# still exists for legacy/automation use, but is no longer the
# recommended path. To create the first admin:
#   1. Start all services (npm run start).
#   2. Open http://localhost:3001/studio in your browser.
#   3. The setup wizard opens automatically (only when no admin exists).
#   4. Fill in the form and click "Create administrator".
# No curl, no terminal, no tokens required.

# ---- Public URL (used for share links, email verification URLs, etc.) ----
APP_PUBLIC_URL=http://localhost:3000

# ============================================================================
# Optional integrations
# ============================================================================

# Yandex Maps API key (set in the FRONTEND .env, not here)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Sentry DSN for error tracking (PII auto-scrubbed)
# SENTRY_DSN=
# SENTRY_SEND_PII=false

# AI ASSISTANT (DeepSeek) — fallback config; preferred is via Studio → AI API
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# TURN server (WebRTC relay) — needed for calls behind symmetric NAT
# TURN_URL=turn:your-turn-server.example.com:3478
# TURN_USERNAME=999pro
# TURN_CREDENTIAL=your-shared-secret
