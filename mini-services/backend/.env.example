# 999 PRO Backend — .env.example
# Copy to .env and edit as needed. NEVER commit the real .env file.
#
# This file is auto-generated by `npm run setup` (scripts/setup.js).
# The setup script generates cryptographically-strong secrets.
#
# v25.5: defaults are tuned for the tri-999.online production domain.
# Override APP_DOMAIN env var before running setup if deploying elsewhere.

# ---- Runtime ----
NODE_ENV=production
PORT=4000

# ---- Database (PostgreSQL — production) ----
# Format:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&connection_limit=10&pool_timeout=10
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/999pro?schema=public&connection_limit=10&pool_timeout=10"

# ---- CORS ----
# v25.5: auto-generated as https://tri-999.online (the production domain).
# Studio is served at /studio on the SAME domain, so only one origin is needed.
CLIENT_ORIGIN="https://tri-999.online"

# ---- Trust proxy (set to "true" if behind Nginx/Caddy/Cloudflare) ----
# v25.5: defaults to true in production (always behind a reverse proxy).
TRUST_PROXY=true

# ---- Auth secrets (auto-generated by setup.js) ----
JWT_SECRET=CHANGE_ME_TO_RANDOM_48_HEX_CHARS
JWT_EXPIRES_IN=7d
RESET_ADMIN_TOKEN=CHANGE_ME_TO_RANDOM_32_HEX_CHARS
IP_HASH_PEPPER=CHANGE_ME_TO_RANDOM_32_HEX_CHARS

# ---- Bcrypt rounds ----
BCRYPT_ROUNDS=12

# ---- Web Push (VAPID) — auto-generated P-256 keypair by setup.js ----
# v25.5: VAPID_SUBJECT MUST be a valid mailto: or https: URL with a real domain.
# iOS Safari 16.4+ PWA push silently fails if the subject is invalid.
VAPID_SUBJECT=mailto:admin@tri-999.online
VAPID_PUBLIC_KEY=CHANGE_ME_BASE64URL_PUBLIC_KEY
VAPID_PRIVATE_KEY=CHANGE_ME_BASE64URL_PRIVATE_KEY

# ---- Email verification ----
# Set to "true" to require email verification before users can use protected routes.
# When true, the backend checks emailVerified on every requireAuth + socket connect.
EMAIL_VERIFICATION_REQUIRED=false

# ---- SMTP (required if EMAIL_VERIFICATION_REQUIRED=true) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@tri-999.online
SMTP_SECURE=false

# ---- Admin / seed ----
BYPASS_ADMIN_TOTP=false
SEED_USER_PASSWORD=demo12345
ADMIN_EMAIL=admin@tri-999.online
ADMIN_USERNAME=admin

# ---- Public URL ----
# v25.5: MUST be a real HTTPS URL in production. The backend fail-fasts at
# startup if this is missing or points to localhost.
APP_PUBLIC_URL=https://tri-999.online

# ---- AI Assistant (optional) ----
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- TURN server (for WebRTC calls behind strict NAT) ----
# Without TURN, ~30% of mobile-to-mobile calls fail to connect.
TURN_URL=turn:turn.tri-999.online:3478
TURN_USERNAME=999pro
TURN_CREDENTIAL=CHANGE_ME_STRONG_PASSWORD

# v25.9.5: Skip mandatory TOTP setup for admins in non-production environments.
# Set to 'true' for local dev/testing. IGNORED in production (NODE_ENV=production).
BYPASS_ADMIN_TOTP=true
