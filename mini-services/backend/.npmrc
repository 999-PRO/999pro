# 999 PRO — .npmrc
# ----------------------------------------------------------------------------
# Allow install-scripts for known-safe native modules. Without this, npm 10+
# blocks postinstall/install scripts by default, which breaks:
#   - sharp (image optimization — needs platform-specific binary)
#   - argon2 (password hashing — needs native binding)
#   - @prisma/client + prisma (need to download query engine binary)
#   - esbuild (used by Next.js — needs platform-specific binary)
#   - @sentry/cli (CLI binary download)
#   - unrs-resolver (used by eslint-plugin-import)
#
# These are all well-known, widely-audited packages. We use the "allow all"
# flag because manually listing every transitive dep with install scripts is
# fragile (the list changes on every npm update). If you want maximum
# security, comment out the line below and run `npm approve-scripts` manually
# after each install.
dangerously-allow-all-scripts=true

# Suppress funding notices (keeps install logs clean)
fund=false

# Suppress audit notices (we run `npm audit` separately in CI)
audit=false
include=dev
