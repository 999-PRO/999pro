// «Три девятки» — Prisma schema
// SQLite database. Run `npm run db:push` to apply changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("BACKEND_DATABASE_URL")
}

// ============================================================
//  USER
// ============================================================
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  phone       String?  @unique
  username    String   @unique
  password    String
  displayName String?
  avatar      String?
  bio         String?
  gender      String?  // male | female | other — для гендерных градиентов в чате
  role        String   @default("user") // user | admin | manager
  isOnline    Boolean  @default(false)
  // tokenVersion is included in every JWT and checked on every protected
  // request. Incrementing it (on password change / logout-everywhere /
  // role demotion) immediately invalidates all previously-issued tokens.
  tokenVersion Int     @default(0)
  lastSeen    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Phase 7.1: Soft delete — instead of CASCADE deleting user's orders,
  // messages, reviews (which destroys financial records and other users'
  // chat history), we mark the user as deleted and anonymize PII.
  // Queries should filter WHERE deletedAt IS NULL for active users.
  deletedAt   DateTime?
  // S-CRIT-009 fix: account lockout after N failed login attempts.
  // failedLoginCount increments on wrong password; lockedUntil is set
  // when count reaches 5 (locks for 15 min). Both reset on successful login.
  failedLoginCount Int       @default(0)
  lockedUntil       DateTime?
  // S-CRIT-008 fix: 2FA / TOTP for admin accounts.
  // totpSecret stores the encrypted TOTP secret (Base32). When null, 2FA is disabled.
  // totpEnabled is true only after the user verifies a TOTP code during setup.
  totpSecret  String?
  totpEnabled Boolean @default(false)
  // S-CRIT-007 fix: email verification on registration.
  // emailVerified is null until the user clicks the verification link.
  emailVerified DateTime?
  // v19.0: 2FA backup codes (JSON array of bcrypt hashes). Generated on
  // TOTP setup. Each code can be used once to bypass TOTP if the user
  // loses their authenticator device.
  totpBackupCodes    String?  // JSON: ["$2b$10$...", "$2b$10$...", ...]
  totpBackupCodesGeneratedAt DateTime?
  // v19.0: email-based 2FA — pending email code + expiry (for users
  // without TOTP who chose email 2FA). Cleared after successful verify.
  emailTwoFactorCode     String?
  emailTwoFactorExpires  DateTime?

  // v12.3.1: stories relation RESTORED (was incorrectly removed with Feed).
  // Stories is a standalone module — Feed (posts/comments/likes) remains deleted.
  favorites         Favorite[]
  cartItems         CartItem[]
  orders            Order[]
  orderStatusChanges OrderStatusHistory[] @relation("UserOrderStatusChanges")
  reviews           Review[]
  conversations     ConversationParticipant[]
  sentMessages      Message[]
  pushSubscriptions PushSubscription[]
  // Call relations — must be explicitly named because User has TWO relation
  // fields to Call (caller + recipient). Without names Prisma throws
  // P1012 "Ambiguous relation detected".
  callsMade         Call[]    @relation("CallCaller")
  callsReceived     Call[]    @relation("CallRecipient")
  // Leads submitted by this user (optional link — anonymous leads have no user)
  leads             Lead[]    @relation("UserLeads")
  // Audit log entries created by this user (admin actions in Studio).
  auditLogs         AuditLog[] @relation("UserAuditLogs")
  // v12.3.1: stories back-relation restored (Stories module is back).
  stories           Story[]
  // Personalization signals — feed into the home page "Recommended for you" block.
  productViews      ProductView[]
  searchHistory     SearchHistory[]
  // Smart Share — events created by this user (anonymous events have userId = null)
  shareEvents       ShareEvent[]

  // v12.4 (CLUB Phase 2): points + referrals. Points are an in-app currency
  // earned via tasks/referrals/purchases and spent on gifts/coupons. They
  // are NOT money and cannot be withdrawn. The PointsTransaction model is
  // an append-only ledger — the `points` field below is a denormalised
  // sum for fast reads, always kept in sync via transactions.
  points            Int       @default(0)
  pointsEarnedTotal Int       @default(0)
  // v12.6: Streak system — tracks consecutive daily visits.
  // `streakCount` increments when the user visits on a new day (reset to 1
  // if a day was skipped). `lastVisitDate` is the date string (YYYY-MM-DD)
  // of the last visit. The landing endpoint updates these automatically.
  streakCount       Int       @default(0)
  lastVisitDate     String?
  // `referredById` points to the user who invited this user (null = organic).
  referralCode      String?   @unique
  referredById      String?
  referredBy        User?     @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]    @relation("UserReferrals")
  // v12.4 CLUB Phase 2 back-relations
  clubGiftClaims        ClubGiftClaim[]
  clubGiveawayParticipations ClubGiveawayParticipant[]
  clubBonusClaims       ClubBonusClaim[]
  clubTaskCompletions   ClubTaskCompletion[]
  clubCouponClaims      ClubCouponClaim[]
  clubEventRegistrations ClubEventRegistration[]
  pointsTransactions    PointsTransaction[]

  // v16.9 MODERATION — back-relations for the moderation system.
  // All named explicitly to avoid Prisma P1012 "Ambiguous relation".
  reportsMade           ModerationReport[]  @relation("UserReportsMade")
  reportsReviewed       ModerationReport[]  @relation("UserReportsReviewed")
  moderationActions     ModerationLog[]     @relation("UserModerationActions")
  warnings              ModerationWarning[] @relation("UserWarnings")
  moderationStats       UserModerationStats? @relation("UserModerationStats")
  aiFlags               AIFlag[]            @relation("UserAIFlags")

  @@index([username])
  @@index([phone])
  @@index([role])
  @@index([isOnline])
  @@index([deletedAt])
}

// ============================================================
//  CATALOG
// ============================================================
model Product {
  id           String   @id @default(cuid())
  title        String
  description  String?
  price        Decimal // Wave 4 (B-DB-001): was Float, rounding errors. Decimal = exact numeric
  oldPrice     Decimal? // Wave 4 (B-DB-001): was Float
  currency     String   @default("RUB")
  category     String?
  images       String   // JSON array of URLs (SQLite has no native arrays)
  rating       Float    @default(0)
  reviewsCount Int      @default(0)
  inStock      Boolean  @default(true)
  // v11: physical stock quantity — used to display "В наличии" / "Заканчивается" / "Нет в наличии".
  // 0 = нет в наличии; >0 = остаток. inStock is the catalog visibility toggle.
  quantity     Int      @default(0)
  // v8-audit-fix: soft-delete for products (admin can archive without breaking OrderItem FK)
  deletedAt    DateTime?
  isPopular    Boolean  @default(false)
  // Curated-section badges (managed by Studio). When true, the product
  // appears in the corresponding block on the home page.
  isAction     Boolean  @default(false) // "Акция"
  isNew        Boolean  @default(false) // "Новинка"
  isRecommended Boolean @default(false) // "Рекомендуем"
  isTrending   Boolean  @default(false) // "В тренде" (Studio manual toggle)
  isPremium    Boolean  @default(false) // "Премиум" (Studio manual toggle)
  // Engagement counters — lifetime totals, used by the smart-ranking
  // algorithm on the home page. These NEVER decrease (a favorite removed
  // still counts as a "favorite add" because the user showed interest).
  views        Int      @default(0) // incremented on every product page open
  purchases    Int      @default(0) // incremented when an order containing this product is created
  cartAdds     Int      @default(0) // incremented when item is added to cart
  favoriteAdds Int      @default(0) // incremented when item is favorited
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // v24.4: Department link — each product belongs to a department (Реклама, Подарки, etc.)
  // When set, the product page shows the department's contacts (manager phone, WhatsApp, etc.)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  favorites  Favorite[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  // v12.3: linkedFrom / linkedTo (ProductLink) relations removed with Feed.
  // Per-user view tracking — used for personalization ("Recommended for you").
  // One row per product open. Anonymous views have userId = null.
  viewEvents  ProductView[]
  // Smart Share — one optional ShareLink per product (1:1)
  shareLink   ShareLink?
  // Smart Share events pointing at this product
  shareEvents ShareEvent[]

  @@index([isPopular])
  @@index([category])
  @@index([createdAt])
  @@index([isAction])
  @@index([isNew])
  @@index([isRecommended])
  @@index([isTrending])
  @@index([isPremium])
  @@index([rating])
  @@index([reviewsCount])
  @@index([views])
  @@index([purchases])
  @@index([deletedAt]) // v9-audit-fix: soft-delete filter index
  @@index([departmentId]) // v24.6-audit (H-DB-6 fix): index on FK for fast department-filtered queries
}

// ProductView — one row per product page open. Used for:
//   1. Personalization: a user's top categories are derived from their recent
//      views and used to boost similar products in the "Recommended for you"
//      block on the home page.
//   2. Trending: products with a spike in recent views are surfaced in the
//      "🔥 Сейчас в тренде" block.
// To keep the table from growing unbounded, a scheduled job should trim rows
// older than 30 days (not implemented yet — see TODO in products.ts).
model ProductView {
  id        String   @id @default(cuid())
  productId String
  userId    String?  // null = anonymous view
  createdAt DateTime @default(now())

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// SearchHistory — every search query a user submits. Used for:
//   1. Personalization: top categories extracted from query terms are folded
//      into the user's interest profile.
//   2. "Search insights" in Studio (future).
model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// v12.3: ProductLink model removed with the Feed module. The only caller
// (products.ts /api/products/:id/linked) was dead code and has been removed.

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  total     Decimal // Wave 4 (B-DB-001): was Float
  status    String   @default("new") // new | in_work | production | ready | in_delivery | done | cancelled
  // v12.7: checkout fields — collected in the CheckoutSheet form
  name           String?
  phone          String?
  address        String?
  deliveryMethod String?  // pickup | delivery
  contactMethod  String?  // whatsapp | telegram | phone | email
  comment        String?
  receiptUrl     String?
  // v12.7: coupon applied at checkout (server-validated)
  couponCode     String?
  discount       Decimal  @default(0) // Wave 4 (B-DB-001): was Float
  // v19.0: promo code applied at checkout (separate from club coupon)
  promoCode      String?
  promoDiscount  Decimal  @default(0)
  // v19.0: bonus points spent (negative delta from user balance) + discount
  pointsSpent    Int      @default(0)
  pointsDiscount Decimal  @default(0)
  // v19.0: bonus points earned for this order (computed at checkout)
  pointsEarned   Int      @default(0)
  // v16: delivery system — coordinates, zone, fee, map link
  lat            Float?
  lng            Float?
  mapUrl         String?   // universal maps URL (geo: or https) for "open in maps"
  deliveryZoneId String?
  deliveryFee    Decimal   @default(0)
  // v16.5: category (for Studio filtering — Реклама/Подарки/Мебель/Полиграфия/Интерьер)
  category       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  statusHistory OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([category])
  // Composite index for the common Studio query: list orders by user+status+date
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

// ============================================================
//  ORDER STATUS HISTORY — v16.5: track every status change for audit
//  + revert capability. Each row = one transition (from → to).
// ============================================================
model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  fromStatus  String
  toStatus    String
  changedById String?
  note        String?
  createdAt   DateTime @default(now())

  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User?  @relation("UserOrderStatusChanges", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// ============================================================
//  DELIVERY ZONES — admin-defined zones (city / republic / country / custom).
//  v16: foundation for future auto-calc / courier / tracking.
// ============================================================
model DeliveryZone {
  id          String   @id @default(cuid())
  name        String   // e.g. "По городу", "По республике", "По России"
  description String?
  cost        Decimal  @default(0) // flat fee now; future: formula/radius/polygon
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@index([isActive, sortOrder])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal // Wave 4 (B-DB-001): was Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // v8-audit-fix: Restrict prevents deleting a product with existing orders
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // v24.6-audit (H-DB-5 fix): missing indexes caused full-table scans on every
  // order fetch (the include: { items: true } join hit an unindexed productId).
  @@index([orderId])
  @@index([productId])
}

// ============================================================
//  STORIES — standalone module (v12.3.1: RESTORED, was incorrectly
//  removed with Feed in v12.3). Stories does NOT depend on Feed.
// ============================================================
model Story {
  id        String   @id @default(cuid())
  userId    String
  media     String   // JSON array of URLs (multi-image story) — single URL still supported as [url]
  mediaType String   @default("image") // image | video
  caption   String?
  category  String?  // admin-defined category (free text —Sport, Lifestyle, etc.)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([expiresAt])
  @@index([userId])
  @@index([category])
}

// v12.3: FEED (Post, Comment, Like) section remains removed — Feed module
// deleted and replaced by 999 CLUB. Stories above is a separate module.

// ============================================================
//  CHAT
// ============================================================
model Conversation {
  id        String   @id @default(cuid())
  // Type of conversation:
  //   'direct'  — regular 1-on-1 chat between two users
  //   'support' — pinned admin ↔ user support channel (auto-created on
  //               registration, cannot be deleted by the user, always
  //               sorted to the top of the chat list)
  type      String   @default("direct")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
  calls        Call[]

  @@index([type])
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String?
  mediaUrl       String?
  mediaType      String?  // text | image | video | audio | file
  // v12: attachments — JSON-encoded array of {url, type, name, size, duration}.
  // When present, the message represents a GROUP of files (e.g. multiple photos,
  // multiple documents, or mixed attachments). mediaUrl/mediaType remain for
  // single-file messages (backward compat) and for product messages.
  attachments    String?
  duration       Int?     // for audio/video in seconds
  isRead         Boolean  @default(false)
  // Reply / forward support
  replyToId      String?
  forwardedFromId String?
  // C-CRIT-002 fix: clientMessageId for idempotency. Client generates a unique
  // tempId per optimistic message send. Server upserts by (conversationId,
  // senderId, clientMessageId) — if a message with the same clientMessageId
  // already exists (e.g. socket retry, REST fallback after socket timeout),
  // the existing message is returned instead of creating a duplicate.
  // Nullable for backward compat with messages created before this column.
  clientMessageId String? @unique
  // Soft-delete: "deletedFor" is a JSON-encoded array of userIds who deleted
  // this message for themselves. "deletedForAll" marks the message as removed
  // for everyone (content/mediaUrl are nulled in that case).
  deletedFor     String   @default("[]")
  deletedForAll  Boolean  @default(false)
  // v16.8-final: optional self-destruct timer for voice messages. When set,
  // a background scheduler deletes the message for everyone (and removes
  // the audio file) after the deadline. Null = no auto-delete.
  // Set by the sender via the ⏱️ Timer button in the voice record panel.
  selfDestructAt DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")
  forwardedFrom Message?    @relation("MessageForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards     Message[]    @relation("MessageForward")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([forwardedFromId])
  // C-CRIT-002: composite index for upsert lookup by (senderId, clientMessageId)
  @@index([senderId, clientMessageId])
  // v16.8-final: index for the self-destruct scheduler's due-query.
  @@index([selfDestructAt])
}

// ============================================================
//  CALLS (audio + video via WebRTC, Socket.IO used for signaling)
// ============================================================
model Call {
  id             String   @id @default(cuid())
  conversationId String
  callerId       String
  recipientId    String
  type           String   // audio | video
  status         String   @default("ringing") // ringing | accepted | rejected | missed | ended | cancelled
  startedAt      DateTime?
  endedAt        DateTime?
  duration       Int?     // seconds
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Both caller and recipient point to User — Prisma requires the relation
  // name to disambiguate which back-relation field on User they correspond to
  // (callsMade vs callsReceived). Without this, P1012 is raised.
  caller       User         @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  recipient    User         @relation("CallRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([callerId])
  @@index([recipientId])
  @@index([status])
}

// ============================================================
//  BANNERS (promo carousel on home page)
// ============================================================
model Banner {
  id          String   @id @default(cuid())
  // v13.0: title is now nullable — image-only banners have no text overlay.
  title       String?
  subtitle    String?
  cta         String   @default("Смотреть")
  image       String
  gradient    String   @default("from-sky-400 via-blue-500 to-indigo-600")
  // When true (default), the banner renders with the gradient overlay over
  // the image (legacy behaviour). When false, the image is shown as-is
  // with no colour overlay, no darkening, and no automatic processing —
  // the admin's image is displayed in full.
  useGradient Boolean  @default(true)
  link        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  // v12.6.4 (now actually wired through the schema):
  //   mode       — 'image-text' (default, classic banner with text overlay)
  //              | 'image-only' (raw image, no text/overlay)
  //   objectFit  — 'cover'   (default, fills the banner box, may crop)
  //              | 'contain' (full image visible, may letterbox)
  mode        String   @default("image-text")
  objectFit   String   @default("cover")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

// ============================================================
//  APP SETTINGS (header image, etc.)
// ============================================================
model AppSetting {
  id    String @id
  value String // JSON-encoded value
}

// ============================================================
//  INFO PAGES — редактируемые информационные страницы приложения.
//  Полностью управляются через Studio (CRUD + reorder + publish).
//  Frontend рендерит страницу по slug через /api/info-pages/:slug.
//  Slug'и зарезервированы: 'about', 'privacy', 'terms', 'cookies',
//  'rights', 'contacts', 'help', 'company' — но администратор может
//  создавать любые новые страницы с произвольными slug'ами.
// ============================================================
model InfoPage {
  id          String   @id @default(cuid())
  // URL-идентификатор: /info/<slug>. Латиница, цифры, дефис. Уникальный.
  slug        String   @unique
  // Заголовок страницы (отображается в шапке и в<title>).
  title       String
  // Подзаголовок/описание (необязательно).
  subtitle    String?
  // Тело страницы в HTML (редактор Studio отправляет sanitize-ированный HTML).
  content     String   @default("")
  // Необязательные изображения (JSON-массив URL'ов в /uploads/...).
  images      String   @default("[]")
  // Иконка (lucide-react имя) для отображения в меню/списках.
  icon        String   @default("FileText")
  // Порядок отображения в списке страниц (меньше = выше).
  order       Int      @default(0)
  // Опубликована ли страница (false = скрыта от пользователей).
  isPublished Boolean  @default(true)
  // Показывать ли страницу в меню "Ещё" (more-sheet) автоматически.
  showInMenu  Boolean  @default(true)
  // SEO meta description (необязательно).
  metaDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, order])
  @@index([showInMenu, isPublished])
}

// ============================================================
//  PUSH SUBSCRIPTIONS — для Web Push уведомлений когда приложение закрыто.
//  Один пользователь может иметь несколько подписок (разные устройства).
// ============================================================
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      String   // JSON: { p256dh, auth }
  userAgent String?
  scope     String?  // SW scope: "/" (main app) or "/studio/" (admin panel) — used to dedup duplicate subs
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, userAgent])
}

// ============================================================
//  REVIEWS — отзывы покупателей на товары.
//  Один пользователь может оставить один отзыв на товар (unique constraint).
//  Отзыв содержит: рейтинг (1-5), текст, опционально фотографии (JSON array).
//  Админ может модерировать (hide) отзывы без их удаления.
// ============================================================
model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int      // 1-5
  title     String?
  content   String?
  photos    String   @default("[]") // JSON array of upload URLs
  isHidden  Boolean  @default(false) // admin moderation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId]) // one review per user per product
  @@index([productId, createdAt])
  @@index([productId, isHidden, createdAt])
  @@index([userId])
  @@index([rating])
  @@index([isHidden])
}

// ============================================================
//  LEADS — заявки пользователей
// ============================================================
model Lead {
  id            String   @id @default(cuid())
  name          String
  phone         String
  comment       String?
  productId     String?
  productTitle  String?
  productPrice  Int?
  productImage  String?
  quantity      Int      @default(1)
  deliveryMethod String?
  address       String?
  contactMethod String?
  receiptUrl    String?
  // Status workflow:
  //   new         —刚刚 submitted, not yet reviewed
  //   processing  — admin reviewing the lead
  //   working     — admin actively working on the request
  //   done        — completed successfully
  //   cancelled   — cancelled by admin or customer
  status        String   @default("new")
  // Optional link to the authenticated user who submitted the lead. Anonymous
  // leads (submitted without login) have userId = null. When present, the
  // user receives real-time status updates via Socket.IO and a push
  // notification when the app is closed.
  userId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User? @relation("UserLeads", fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

// ============================================================
//  AUDIT LOG — records admin actions in Studio for compliance & debugging.
//  Every create/update/delete on products, banners, stories, leads, etc.
//  is logged with: who, when, what action, on what entity, before/after.
// ============================================================
model AuditLog {
  id        String   @id @default(cuid())
  // The admin user who performed the action. SetNull on user delete so
  // we keep the audit trail even after the admin leaves the company.
  userId    String?
  // Entity type: 'product' | 'banner' | 'story' | 'lead' | 'order' | etc.
  entity    String
  // Entity ID (cuid) — null for bulk actions like "deleted all expired stories"
  entityId  String?
  // Action: 'create' | 'update' | 'delete' | 'status_change' | 'bulk_delete'
  action    String
  // JSON snapshot: { before: {...}, after: {...} }
  // For create: { before: null, after: {...} }
  // For delete: { before: {...}, after: null }
  // For update: { before: {...}, after: {...} }
  // For status_change: { before: 'new', after: 'done' }
  snapshot  String   @default("{}")
  // IP address of the actor — for forensic analysis
  ip        String?
  // User-Agent of the actor
  userAgent String?
  // S-HIGH-009 fix: tamper-evident hash chain. Each entry's hash is computed
  // from (prevHash + userId + entity + entityId + action + snapshot + createdAt).
  // An attacker with DB access cannot modify an entry without recomputing all
  // subsequent hashes — which requires knowing the chain head.
  prevHash  String?
  hash      String?
  createdAt DateTime @default(now())

  user User? @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, action, createdAt])
  @@index([entityId])
  @@index([createdAt])
}

// v12.3: FEED SUBSCRIPTIONS section removed with the Feed module.

// ============================================================
//  SMART SHARE — short external links for products.
//
//  Each product gets one ShareLink with a short, opaque `shortId`
//  (8 chars, base62 — 62^8 ≈ 218 trillion combinations). The short
//  link is used in:
//    • Web Share API (WhatsApp, Telegram, etc.)
//    • QR codes
//    • OG meta tags
//    • Deep link /dl/<shortId> that opens the app or falls back to /p/<shortId>
//
//  Counters are denormalized onto the row for fast Studio dashboard
//  reads (no COUNT(*) over millions of events). They are updated
//  atomically when a ShareEvent row is inserted.
// ============================================================
model ShareLink {
  id          String   @id @default(cuid())
  // 8-char base62 short id — used in /p/<shortId> URLs.
  // Generated server-side, never exposes the internal Product.id.
  shortId     String   @unique
  productId   String   @unique
  // Cumulative counters (denormalized for dashboards)
  sharesCount     Int  @default(0) // total "share" button presses
  opensCount      Int  @default(0) // total /p/<shortId> page views
  appOpensCount   Int  @default(0) // deep-link clicks that opened the app
  installsCount   Int  @default(0) // first-run detection from a share link
  ordersCount     Int  @default(0) // orders placed after visiting a share link
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  events  ShareEvent[]

  @@index([productId])
  @@index([updatedAt])
}

// ============================================================
//  SHARE EVENTS — one row per share / open / install / order event.
//  Used for granular analytics (per-platform breakdown, time series).
//
//  eventType:
//    'share'    — user pressed a Share button (with platform = whatsapp|telegram|…)
//    'open'     — share page /p/<shortId> was viewed (platform = web|in-app)
//    'app_open' — deep link opened the installed app
//    'install'  — app was first-launched with a share referrer
//    'order'    — order was placed after visiting a share link
// ============================================================
model ShareEvent {
  id          String   @id @default(cuid())
  shareLinkId String
  productId   String
  // Platform: whatsapp | telegram | instagram | facebook | vk |
  //           messenger | x | email | copy | qrcode | web | in-app | unknown
  platform    String   @default("unknown")
  // EventType: share | open | app_open | install | order
  eventType   String
  // Optional: user who performed the action (anonymous = null)
  userId      String?
  // IP for abuse detection (rate limiting, fraud scoring)
  // P-HIGH-004 fix: IP is now SHA-256 hashed with daily-rotated salt (GDPR)
  ip          String?
  // User-agent (for device breakdown)
  userAgent   String?
  // Referrer (utm_source / referer header) — for marketing attribution
  referrer    String?
  // Wave 6d: ref attribution — which share platform drove this open/install
  ref         String?
  // Wave 6d: UTM parameters for ad campaign attribution
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shareLinkId, createdAt])
  @@index([productId, eventType, createdAt])
  // Wave 6d: index for ref attribution queries
  @@index([ref, eventType])
  @@index([utmSource, utmCampaign])
  @@index([platform, eventType, createdAt])
  @@index([createdAt])
}

// ============================================================
//  999 CLUB — Phase 2 models (v12.4)
//  8 entity types + points ledger + referral tracking.
//  All standalone — no dependencies on the (deleted) Feed module.
// ============================================================

// ---------- 🎁 GIFTS ----------
model ClubGift {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String?
  // Points cost to claim (0 = free gift). Most gifts will be free in Phase 2.
  pointsCost  Int      @default(0)
  // Limited quantity: null = unlimited. When `claimedCount >= quantity`,
  // the gift is sold out.
  quantity    Int?
  claimedCount Int     @default(0)
  // Time window (null = no expiry). Claims outside the window are rejected.
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  claims ClubGiftClaim[]

  @@index([active, order])
  @@index([endsAt])
}

model ClubGiftClaim {
  id        String   @id @default(cuid())
  giftId    String
  userId    String
  createdAt DateTime @default(now())

  gift ClubGift @relation(fields: [giftId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giftId, userId]) // one claim per user per gift
  @@index([userId, createdAt])
}

// ---------- 🔥 PROMOS ----------
model ClubPromo {
  id             String   @id @default(cuid())
  title          String
  description    String?
  image          String?
  // Promo code to apply at checkout (optional — some promos are informational)
  promoCode      String?
  discountPercent Int?    // 0-100
  // Linked product IDs (JSON array of strings) — "see also" products
  linkedProductIds String? // JSON: ["id1","id2"]
  // CTA button
  ctaText        String   @default("Перейти")
  ctaUrl         String?
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active, order])
  @@index([endsAt])
}

// ---------- 🏆 GIVEAWAYS ----------
model ClubGiveaway {
  id               String   @id @default(cuid())
  title            String
  description      String?
  image            String?
  // Number of winners (default 1)
  winnersCount     Int      @default(1)
  // Scheduled draw time. When `drawnAt` is null, the giveaway is still open.
  // After `drawnAt`, no new participants can join.
  drawAt           DateTime
  drawnAt          DateTime?
  // Winner user IDs (JSON array) — set when the draw runs
  winnerIds        String?  // JSON: ["userId1","userId2"]
  active           Boolean  @default(true)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  participants ClubGiveawayParticipant[]

  @@index([active, order])
  @@index([drawAt])
}

model ClubGiveawayParticipant {
  id          String   @id @default(cuid())
  giveawayId  String
  userId      String
  createdAt   DateTime @default(now())

  giveaway ClubGiveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId]) // one entry per user per giveaway
  @@index([giveawayId, createdAt])
}

// ---------- ⭐ BONUSES (points-earning opportunities) ----------
model ClubBonus {
  id            String   @id @default(cuid())
  title         String
  description   String?
  image         String?
  // Points awarded when the bonus is claimed
  pointsReward  Int      @default(0)
  // Time window (null = always available)
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  claims ClubBonusClaim[]

  @@index([active, order])
  @@index([endsAt])
}

model ClubBonusClaim {
  id        String   @id @default(cuid())
  bonusId   String
  userId    String
  createdAt DateTime @default(now())

  bonus ClubBonus @relation(fields: [bonusId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bonusId, userId]) // one claim per user per bonus
  @@index([userId, createdAt])
}

// ---------- 🎯 TASKS ----------
model ClubTask {
  id            String   @id @default(cuid())
  title         String
  description   String?
  // Task type: 'daily' (resets every 24h) | 'one-time' (once per user)
  taskType      String   @default("one-time") // daily | one-time
  // Points awarded on completion
  pointsReward  Int      @default(0)
  // Optional gift reward (gift ID) — when set, completing the task
  // auto-claims the gift for the user.
  giftRewardId  String?
  // Action identifier — the frontend uses this to know what action to
  // perform (e.g. 'complete_profile', 'add_avatar', 'first_order', 'leave_review')
  actionKey     String?
  active        Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  completions ClubTaskCompletion[]

  @@index([active, order])
  @@index([taskType])
}

model ClubTaskCompletion {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  // For daily tasks, the date (YYYY-MM-DD) this completion is for.
  // For one-time tasks, this is null.
  forDate   String?
  createdAt DateTime @default(now())

  task ClubTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId, forDate]) // one completion per task/user/date
  @@index([userId, createdAt])
}

// ---------- 🎟 COUPONS ----------
model ClubCoupon {
  id            String   @id @default(cuid())
  title         String
  description   String?
  image         String?
  // Coupon code (optional — some coupons are auto-applied)
  code          String?
  // Discount: either percent or fixed amount
  discountType  String   @default("percent") // percent | fixed
  discountValue Int      @default(0)
  // Category restriction (null = any category). Matches Product.category.
  category      String?
  // Linked product IDs (JSON array) — null = any product
  linkedProductIds String? // JSON: ["id1","id2"]
  // Usage limit: null = unlimited. `usedCount` tracks current usage.
  quantity      Int?
  usedCount     Int      @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  claims ClubCouponClaim[]

  @@index([active, order])
  @@index([endsAt])
}

model ClubCouponClaim {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  createdAt DateTime @default(now())

  coupon ClubCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId]) // one claim per user per coupon
  @@index([userId, createdAt])
}

// ---------- 📅 EVENTS ----------
model ClubEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String?
  // Event location (online URL or physical address)
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  // Max attendees (null = unlimited)
  maxAttendees Int?
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registrations ClubEventRegistration[]

  @@index([active, order])
  @@index([startsAt])
}

model ClubEventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event ClubEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId]) // one registration per user per event
  @@index([userId, createdAt])
}

// ---------- POINTS LEDGER (append-only) ----------
// Every points change (earn or spend) is recorded here. The User.points
// field is a denormalised sum for fast reads; this table is the source of
// truth. Never update or delete rows — only insert.
model PointsTransaction {
  id        String   @id @default(cuid())
  userId    String
  // Signed delta: positive = earned, negative = spent
  delta     Int
  // Reason code: 'registration' | 'referral' | 'task' | 'bonus' | 'gift_claim' | 'purchase' | 'admin_adjust'
  reason    String
  // Optional reference to the entity that triggered the transaction
  entityId  String?
  entityType String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reason, createdAt])
}

// ============================================================
//  MODERATION SYSTEM (v16.9)
//
//  Production-grade two-level moderation:
//    Level 1 — local check (stop-words, spam, flood, links) in lib/moderation.ts
//    Level 2 — AI check (semantic analysis) in lib/moderation-ai.ts
//
//  Privacy by design: only flagged/reported/blocked content is stored.
//  Regular private chats are NEVER bulk-stored in moderation tables.
// ============================================================

// Stop-words dictionary — fully managed via Studio.
// Each word is normalized (lowercase, trim) before storage.
// Categories: profanity | insult | extremism | terrorism | violence | drugs | fraud | spam | ads | custom
model StopWord {
  id        String   @id @default(cuid())
  word      String   // normalized: lowercase, trimmed
  category  String   @default("custom")
  isActive  Boolean  @default(true)
  severity  String   @default("medium") // low | medium | high
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  // admin user id (null = system default)

  @@index([category, isActive])
  @@index([word])
  @@index([isActive])
}

// User-submitted reports (from chat context menu "Пожаловаться").
// Each report references a target entity (message, review, profile).
model ModerationReport {
  id           String    @id @default(cuid())
  reporterId   String
  targetType   String    // message | review | profile | user
  targetId     String    // id of the reported entity
  reason       String    // spam | insult | threat | fraud | forbidden | other
  comment      String?   // optional description from reporter
  status       String    @default("pending") // pending | reviewed | dismissed | actioned
  reviewedBy   String?
  reviewedAt   DateTime?
  decision     String?
  createdAt    DateTime  @default(now())

  reporter     User      @relation("UserReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer     User?     @relation("UserReportsReviewed", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([createdAt])
}

// Audit log of ALL moderation actions (AI + admin + system).
// This is separate from AuditLog because moderation actions are higher-volume
// and have different retention/query patterns.
model ModerationLog {
  id          String   @id @default(cuid())
  actorType   String   // ai | admin | system
  actorId     String?  // admin user id (null for AI/system)
  action      String   // block_message | hide_message | warn_user | ban_user | restrict_chat | restrict_reviews | delete_review | restore_message | unban_user | stopword_add | stopword_delete | setting_change | ...
  targetType  String   // message | review | profile | user | stopword | setting
  targetId    String?
  reason      String?
  details     String   @default("{}") // JSON snapshot
  createdAt   DateTime @default(now())

  actor       User?    @relation("UserModerationActions", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorType, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([action, createdAt])
}

// Warnings issued to users (manual by admin or automatic by AI).
model ModerationWarning {
  id              String    @id @default(cuid())
  userId          String
  reason          String
  message         String?
  severity        String    @default("medium") // low | medium | high
  expiresAt       DateTime? // null = permanent until acknowledged
  acknowledgedAt  DateTime?
  createdBy       String?   // admin user id or "ai" or "system"
  createdAt       DateTime  @default(now())

  user            User      @relation("UserWarnings", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([acknowledgedAt])
}

// Per-user moderation stats (1:1 with User).
// Denormalized counters for fast dashboard queries.
model UserModerationStats {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  violationsCount          Int       @default(0)
  reportsCount             Int       @default(0) // reports AGAINST this user
  deletedMessagesCount     Int       @default(0)
  deletedReviewsCount      Int       @default(0)
  warningsCount            Int       @default(0)
  bansCount                Int       @default(0)
  chatRestrictedUntil      DateTime?
  reviewsRestrictedUntil   DateTime?
  commentsRestrictedUntil  DateTime? // reserved (no comments system yet)
  isBanned                 Boolean   @default(false)
  banReason                String?
  bannedUntil              DateTime?
  bannedBy                 String?
  bannedAt                 DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user                     User      @relation("UserModerationStats", fields: [userId], references: [id], onDelete: Cascade)

  @@index([isBanned])
  @@index([chatRestrictedUntil])
  @@index([reviewsRestrictedUntil])
  @@index([bannedUntil])
}

// AI-flagged content — only content that AI scored as potentially dangerous.
// This is the ONLY place where message content is stored outside the Message
// table, and ONLY for flagged content. Regular chats are never stored here.
model AIFlag {
  id          String    @id @default(cuid())
  userId      String
  targetType  String    // message | review | profile | username
  targetId    String?
  content     String    // the flagged content (truncated to 2000 chars)
  reason      String    // categories detected (comma-separated)
  confidence  Float     @default(0) // 0-1
  severity    String    @default("medium") // low | medium | high
  action      String    @default("flagged") // blocked | flagged | hidden
  reviewed    Boolean   @default(false)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation("UserAIFlags", fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewed, createdAt])
  @@index([userId, createdAt])
  @@index([targetType, targetId])
  @@index([severity, createdAt])
}

// ============================================================================
//  AI KNOWLEDGE BASE  (v18.5 — AI Assistant)
// ----------------------------------------------------------------------------
//  DeepSeek NEVER stores product / price info. The backend always reads from
//  these tables and feeds ready numbers to the model. The model only formats
//  the final response in natural language.
// ============================================================================

// A category groups KB products (e.g. "Баннеры", "Вывески", "Подарки").
// Categories are managed via Studio — full CRUD, no code changes.
model AIKB_Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    AIKB_Product[]
}

// A product in the AI Knowledge Base. Distinct from the marketplace Product
// model — KB products can have rich pricing logic, services, instructions.
// A KB product MAY reference a marketplace Product id (optional link) so the
// studio admin can keep both in sync, but it is not required.
model AIKB_Product {
  id            String   @id @default(cuid())
  // Optional link to the marketplace Product (so KB can reuse catalog data).
  marketplaceProductId String?
  name          String
  slug          String   @unique
  description   String?
  // Short summary used as the AI's product card (one paragraph).
  shortSummary  String?
  // Materials (JSON array of strings, e.g. ["Акрил 3мм","ПВХ 5мм"])
  materials     String   @default("[]")
  // Tech specs (JSON object: { "Вес": "1.2 кг", "Срок службы": "5 лет" })
  specs         String   @default("{}")
  // Manufacturing time / lead time in human form, e.g. "2–4 рабочих дня"
  leadTime      String?
  // Warranty text, e.g. "12 месяцев на материал и монтаж"
  warranty      String?

  // Pricing type drives how `basePrice` is interpreted.
  //   fixed            — single price (mug, photostone)
  //   per_unit         — per piece
  //   per_sq_meter     — per m² (banners, signs by area)
  //   per_linear_meter — per linear meter (strips, moldings)
  //   per_set          — per kit/bundle
  //   range            — min/max price (use basePrice=minimum, maxPrice=maximum)
  //   quote            — "по запросу" — AI should ask for details
  pricingType   String   @default("fixed")
  basePrice     Float    @default(0)   // RUB
  maxPrice      Float?                 // for "range" type
  currency      String   @default("RUB")
  minOrderValue Float?                 // optional minimum order cost

  // Free-form formula description shown to the AI:
  //   "Ширина × Высота × Цена_за_м² + Дизайн + Монтаж + Доставка"
  formula       String?
  // Structured formula spec (JSON) used by the calculation engine.
  // See backend src/lib/ai-calc.ts for the supported schema.
  formulaSpec   String   @default("{}")

  // Per-product AI instruction (multi-line text). The admin writes this in
  // Studio and the backend injects it into the system prompt when this
  // product is mentioned.
  // Example:
  //   "Если клиент не указал размеры — сначала спросить ширину и высоту.
  //    Потом предложить дизайн. Потом монтаж. Потом доставку."
  aiInstruction String?

  images        String   @default("[]") // JSON array of URLs
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categoryId    String?
  category      AIKB_Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Additional services that may be added to this product (design, mount…)
  services      AIKB_Service[]
  // Frequent questions and their authoritative answers.
  faqs          AIKB_FAQ[]

  @@index([categoryId])
  @@index([isActive])
  @@index([pricingType])
  @@index([slug])
}

// Additional service that can be attached to a product (design, mount,
// delivery, urgency surcharge, etc.). Each service has its own pricing.
model AIKB_Service {
  id          String   @id @default(cuid())
  productId   String
  product     AIKB_Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String   // "Дизайн", "Монтаж", "Доставка"
  description String?
  // Service pricing type:
  //   fixed       — flat price (e.g. design = 1500 RUB)
  //   percent     — % of the base product cost (e.g. mount = 15%)
  //   per_unit    — per square meter / per piece etc. (uses pricePer)
  //   per_sq_meter, per_linear_meter — same as product
  pricingType String   @default("fixed")
  price       Float    @default(0)
  // For percent type, `price` holds the percent value (e.g. 15 = 15%).
  // For per_* types, `price` is the unit price.
  // Whether this service is included by default in the calculation.
  isDefault   Boolean  @default(false)
  // Optional condition code (free-form, shown to AI only):
  //   "Применяется только при заказе от 5000 ₽"
  condition   String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
}

// Frequent question + authoritative answer. AI may use these verbatim.
model AIKB_FAQ {
  id          String   @id @default(cuid())
  productId   String?
  product     AIKB_Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  // If productId is null — this is a global FAQ (applies to everything).
  question    String
  answer      String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
}

// Global AI settings — system prompt preamble, fallback message, etc.
// Stored as a single-row table (key/value pairs merged into one JSON).
model AIKB_Settings {
  id             String   @id @default("default")
  // Global system prompt prepended to every AI conversation.
  // The admin writes the "personality" + business rules here.
  systemPrompt   String   @default("")
  // Fallback response when AI cannot help (e.g. KB has no matching product).
  fallbackMessage String  @default("Извините, я не нашёл информацию по вашему запросу. Уточните, пожалуйста, детали — и я обязательно помогу.")
  // Greeting shown when the assistant opens (before the user has typed).
  greeting       String   @default("Здравствуйте! Я Агент 999. Чем могу помочь?")
  // Assistant persona name shown in the UI.
  assistantName  String   @default("Агент 999")
  updatedAt      DateTime @updatedAt
}

// Audit log for AI conversations (optional — used to improve KB over time).
// Stores user message + assistant reply + extracted parameters.
model AIKB_Conversation {
  id          String   @id @default(cuid())
  userId      String?
  // Context: which view was open when the user invoked the assistant.
  context     String?
  // The user's message (transcribed if voice).
  userMessage String
  // The assistant's reply.
  assistantReply String
  // Extracted parameters (JSON: { product, width, height, services[] })
  parameters  String?
  // Calculated total price (if any), for analytics.
  totalPrice  Float?
  // Whether the conversation was served from local cache (no DeepSeek call).
  localHandled Boolean @default(false)
  // ISO timestamp
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([localHandled])
}

// ============================================================
//  v19.0 — MULTI-PROVIDER AI CONFIG
//  Allows admin to configure multiple AI providers (DeepSeek,
//  OpenAI, Gemini, Claude, Grok, OpenRouter, custom) and switch
//  between them at runtime via Studio.
//  API keys are encrypted at rest with AES-256-GCM (see lib/crypto.ts).
// ============================================================
model AIProvider {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("deepseek") // deepseek|openai|gemini|claude|grok|openrouter|ollama|custom
  apiKeyEnc   String   @default("") // AES-256-GCM encrypted
  baseUrl     String   @default("")
  model       String   @default("")
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  params      String   @default("{}") // JSON: temperature, maxTokens, systemPrompt override
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, isDefault])
  @@index([type])
}

// ============================================================
//  v19.0 — PROMO CODES (standalone, redeemable at checkout)
// ============================================================
model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String?
  discountType    String   @default("percent") // percent | fixed
  discountValue   Decimal  @default(0)
  minOrderTotal   Decimal  @default(0)
  maxDiscount     Decimal?
  maxUses         Int?
  maxUsesPerUser  Int?
  usedCount       Int      @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean  @default(true)
  category        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  usages PromoCodeUsage[]

  @@index([active, code])
  @@index([endsAt])
}

model PromoCodeUsage {
  id          String   @id @default(cuid())
  promoCodeId String
  userId      String
  orderId     String?
  createdAt   DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@index([userId, createdAt])
}

// ============================================================
//  v19.0 — BONUS POINTS SETTINGS (single-row)
// ============================================================
model BonusPointsSettings {
  id                      String   @id @default("default")
  earnRate                Decimal  @default(1)  // points per `earnPerCurrencyUnit` RUB
  earnPerCurrencyUnit     Decimal  @default(100)
  pointValue              Decimal  @default(1)  // 1 point = 1 RUB discount
  minOrderTotalToSpend    Decimal  @default(0)
  maxPercentOfOrder       Int      @default(50)
  maxPointsBalance        Int?
  expiryDays              Int?
  welcomeBonus            Int      @default(0)
  enabled                 Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

// ============================================================
//  v19.0 — SECURITY SETTINGS (single-row)
// ============================================================
model SecuritySettings {
  id                            String   @id @default("default")
  emailVerificationRequired     Boolean  @default(false)
  totpRequiredForAdmins         Boolean  @default(true)
  totpRequiredForUsers          Boolean  @default(false)
  totpAllowBackupCodes          Boolean  @default(true)
  allowLoginWithoutVerification Boolean  @default(true)
  sessionTimeoutMin             Int      @default(10080) // 7 days
  refreshTokenTTLDays           Int      @default(30)
  maxFailedLogins               Int      @default(5)
  lockoutDurationMin            Int      @default(15)
  passwordMinLength             Int      @default(8)
  passwordMaxLength             Int      @default(128)
  passwordRequireUppercase      Boolean  @default(false)
  passwordRequireLowercase      Boolean  @default(true)
  passwordRequireDigit          Boolean  @default(false)
  passwordRequireSymbol         Boolean  @default(false)
  authRateLimitPer15Min         Int      @default(10)
  updatedAt                     DateTime @updatedAt
}

// ============================================================
//  DEPARTMENT — v24.4
//  Universal contacts system by direction (Реклама, Подарки, Мебель, etc.)
//  Each department has its own contacts (phone, WhatsApp, Telegram, email, address, manager name).
//  Products are linked to departments so users see the right manager's contacts.
// ============================================================
model Department {
  id          String   @id @default(cuid())
  name        String   @unique // "Реклама", "Подарки", "Мебель", etc.
  slug        String   @unique @default("") // URL-friendly identifier
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  // Contact fields
  phone       String?  // Phone number
  whatsapp    String?  // WhatsApp number/link
  telegram    String?  // Telegram username/link
  email       String?  // Email address
  address     String?  // Physical address
  managerName String?  // Manager's display name
  // Optional: description / notes
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Products linked to this department
  products    Product[]
}
