  action      String
  targetType  String
  targetId    String?
  reason      String?
  details     String   @default("{}")
  createdAt   DateTime @default(now())

  actor       User?    @relation("UserModerationActions", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorType, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([action, createdAt])
}

model ModerationWarning {
  id              String    @id @default(cuid())
  userId          String
  reason          String
  message         String?
  severity        String    @default("medium")
  expiresAt       DateTime?
  acknowledgedAt  DateTime?
  createdBy       String?
  createdAt       DateTime  @default(now())

  user            User      @relation("UserWarnings", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([acknowledgedAt])
}

model UserModerationStats {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  violationsCount          Int       @default(0)
  reportsCount             Int       @default(0)
  deletedMessagesCount     Int       @default(0)
  deletedReviewsCount      Int       @default(0)
  warningsCount            Int       @default(0)
  bansCount                Int       @default(0)
  chatRestrictedUntil      DateTime?
  reviewsRestrictedUntil   DateTime?
  commentsRestrictedUntil  DateTime?
  isBanned                 Boolean   @default(false)
  banReason                String?
  bannedUntil              DateTime?
  bannedBy                 String?
  bannedAt                 DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user                     User      @relation("UserModerationStats", fields: [userId], references: [id], onDelete: Cascade)

  @@index([isBanned])
  @@index([chatRestrictedUntil])
  @@index([reviewsRestrictedUntil])
  @@index([bannedUntil])
}

model AIFlag {
  id          String    @id @default(cuid())
  userId      String
  targetType  String
  targetId    String?
  content     String
  reason      String
  confidence  Float     @default(0)
  severity    String    @default("medium")
  action      String    @default("flagged")
  reviewed    Boolean   @default(false)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation("UserAIFlags", fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewed, createdAt])
  @@index([userId, createdAt])
  @@index([targetType, targetId])
  @@index([severity, createdAt])
}

// ============================================================
//  v18.5 — AI Knowledge Base (categories, products, services, FAQs, settings, conversation log)
// ============================================================

model AIKB_Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    AIKB_Product[]
}

model AIKB_Product {
  id            String   @id @default(cuid())
  marketplaceProductId String?
  name          String
  slug          String   @unique
  description   String?
  shortSummary  String?
  materials     String   @default("[]")
  specs         String   @default("{}")
  leadTime      String?
  warranty      String?
  pricingType   String   @default("fixed")
  basePrice     Float    @default(0)
  maxPrice      Float?
  currency      String   @default("RUB")
  minOrderValue Float?
  formula       String?
  formulaSpec   String   @default("{}")
  aiInstruction String?
  images        String   @default("[]")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  categoryId    String?
  category      AIKB_Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  services      AIKB_Service[]
  faqs          AIKB_FAQ[]

  @@index([categoryId])
  @@index([isActive])
  @@index([pricingType])
  @@index([slug])
}

model AIKB_Service {
  id          String   @id @default(cuid())
  productId   String
  product     AIKB_Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  description String?
  pricingType String   @default("fixed")
  price       Float    @default(0)
  isDefault   Boolean  @default(false)
  condition   String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
}

model AIKB_FAQ {
  id          String   @id @default(cuid())
  productId   String?
  product     AIKB_Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
}

model AIKB_Settings {
  id             String   @id @default("default")
  systemPrompt   String   @default("")
  fallbackMessage String  @default("Извините, я не нашёл информацию по вашему запросу. Уточните, пожалуйста, детали — и я обязательно помогу.")
  greeting       String   @default("Здравствуйте! Я Агент 999. Чем могу помочь?")
  assistantName  String   @default("Агент 999")
  updatedAt      DateTime @updatedAt
}

model AIKB_Conversation {
  id          String   @id @default(cuid())
  userId      String?
  context     String?
  userMessage String
  assistantReply String
  parameters  String?
  totalPrice  Float?
  localHandled Boolean @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([localHandled])
}

// ============================================================
//  v25.9 — AI AGENT: PERSISTENT CONVERSATIONS & MESSAGES
// ============================================================
// Previously the AI assistant had only an in-memory history (lost on reload)
// and a flat log table (AIKB_Conversation). The user explicitly requested
// persistent history, cross-device sync, and the ability to resume old
// conversations. These two models provide a proper threaded structure.

model AIConversation {
  id          String   @id @default(cuid())
  userId      String?
  title       String   @default("Новый диалог")
  context     String?  // current app view ("catalog", "chat", etc.)
  role        String   @default("user") // user | admin | guest
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    AIMessage[]

  @@index([userId, updatedAt])
  @@index([pinned, updatedAt])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user | assistant | tool
  content        String
  // Optional structured payload (JSON-encoded):
  //   - assistant cards (products found)
  //   - actions (open_catalog, open_product, etc.)
  //   - calculation result
  //   - images attached by user (vision)
  cards          String?
  actions        String?
  calculation    String?
  images         String?
  createdAt      DateTime @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ============================================================
//  v19.0 — MULTI-PROVIDER AI CONFIG
// ============================================================

model AIProvider {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("deepseek")
  apiKeyEnc   String   @default("")
  baseUrl     String   @default("")
  model       String   @default("")
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  params      String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, isDefault])
  @@index([type])
}

// ============================================================
//  v19.0 — PROMO CODES (standalone, redeemable at checkout)
// ============================================================

model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String?
  discountType    String   @default("percent")
  discountValue   Decimal   @default(0)
  minOrderTotal   Decimal   @default(0)
  maxDiscount     Decimal? 
  maxUses         Int?
  maxUsesPerUser  Int?
  usedCount       Int      @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean  @default(true)
  category        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  usages PromoCodeUsage[]

  @@index([active, code])
  @@index([endsAt])
}

model PromoCodeUsage {
  id          String   @id @default(cuid())
  promoCodeId String
  userId      String
  orderId     String?
  createdAt   DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@index([userId, createdAt])
}

// ============================================================
//  v19.0 — BONUS POINTS SETTINGS (single-row)
// ============================================================

model BonusPointsSettings {
  id                      String   @id @default("default")
  earnRate                Decimal   @default(1)
  earnPerCurrencyUnit     Decimal   @default(100)
  pointValue              Decimal   @default(1)
  minOrderTotalToSpend    Decimal   @default(0)
  maxPercentOfOrder       Int      @default(50)
  maxPointsBalance        Int?
  expiryDays              Int?
  welcomeBonus            Int      @default(0)
  enabled                 Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

// ============================================================
//  v19.0 — SECURITY SETTINGS (single-row)
// ============================================================

model SecuritySettings {
  id                            String   @id @default("default")
  emailVerificationRequired     Boolean  @default(false)
  totpRequiredForAdmins         Boolean  @default(true)
  totpRequiredForUsers          Boolean  @default(false)
  totpAllowBackupCodes          Boolean  @default(true)
  allowLoginWithoutVerification Boolean  @default(true)
  sessionTimeoutMin             Int      @default(10080)
  refreshTokenTTLDays           Int      @default(30)
  maxFailedLogins               Int      @default(5)
  lockoutDurationMin            Int      @default(15)
  passwordMinLength             Int      @default(8)
  passwordMaxLength             Int      @default(128)
  passwordRequireUppercase      Boolean  @default(false)
  passwordRequireLowercase      Boolean  @default(true)
  passwordRequireDigit          Boolean  @default(false)
  passwordRequireSymbol         Boolean  @default(false)
  authRateLimitPer15Min         Int      @default(10)
  updatedAt                     DateTime @updatedAt
}

// ============================================================
//  DEPARTMENTS — v24.6-audit (C-DB-1 fix): was missing from postgres schema.
//  Mirrors the SQLite schema model 1:1. Used by /api/departments/* routes
//  and the multi-department contacts system (Stage 20 of audit).
// ============================================================
model Department {
  id          String   @id @default(cuid())
  name        String   @unique // "Реклама", "Подарки", "Мебель", etc.
  slug        String   @unique @default("") // URL-friendly identifier
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  // Contact fields
  phone       String?  // Phone number
  whatsapp    String?  // WhatsApp number/link
  telegram    String?  // Telegram username/link
  email       String?  // Email address
  address     String?  // Physical address
  managerName String?  // Manager's display name
  // Optional: description / notes
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Products linked to this department
  products    Product[]
}
